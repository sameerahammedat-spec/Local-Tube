{
    "name": "localtube",
    "version": "1.0.0",
    "description": "Local-first distraction-reduced video library for Windows",
    "main": "electron/main.cjs",
    "author": "LocalTube",
    "license": "MIT",
    "scripts": {
        "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
        "start": "electron .",
        "build": "vite build",
        "dist": "npm run build && electron-builder --win nsis",
        "postinstall": "electron-builder install-app-deps",
        "test": "node --test"
    },
    "dependencies": {
        "@capacitor-community/sqlite": "^8.1.1",
        "@capacitor/android": "^8.6.0",
        "@capacitor/core": "^8.6.0",
        "@capacitor/filesystem": "^8.1.5",
        "@capacitor/preferences": "^8.0.1",
        "@capawesome/capacitor-file-picker": "^8.1.1",
        "better-sqlite3": "^11.7.0",
        "jeep-sqlite": "^2.8.0",
        "lucide-react": "^0.468.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.6.0",
        "@vitejs/plugin-react": "^4.3.4",
        "concurrently": "^9.1.2",
        "cross-env": "^10.1.0",
        "electron": "33.2.1",
        "electron-builder": "25.1.8",
        "vite": "^6.0.5",
        "wait-on": "^8.0.1"
    },
    "build": {
        "appId": "com.localtube.desktop",
        "productName": "LocalTube",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json"
        ],
        "asarUnpack": [
            "node_modules/better-sqlite3/**/*"
        ],
        "win": {
            "target": "nsis",
            "artifactName": "LocalTube-Setup-${version}.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true
        }
    }
}
